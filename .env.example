# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: API Key for Resend Email dispatch.
# Configure at https://resend.com/api-keys
RESEND_API_KEY=""

# RESEND_FROM_EMAIL: Default from address (e.g. "CollectIQ <notifications@yourdomain.com>")
RESEND_FROM_EMAIL="CollectIQ Notifications <notifications@collectiq.io>"

# WHATSAPP_ACCESS_TOKEN: Permanent System User Access Token from Meta Business Manager
# Generate at: Meta Business Settings > Users > System Users > Generate New Token (whatsapp_business_messaging, whatsapp_business_management)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_CLOUD_ACCESS_TOKEN=""

# WHATSAPP_PHONE_NUMBER_ID: Phone number ID for WhatsApp Business Cloud API
# Found at: Meta Developer Portal > WhatsApp > API Setup > Step 1: Phone number ID
WHATSAPP_PHONE_NUMBER_ID=""

# WHATSAPP_BUSINESS_ACCOUNT_ID: WhatsApp Business Account ID (WABA ID)
# Found at: Meta Developer Portal > WhatsApp > API Setup > WhatsApp Business Account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_WABA_ID=""

# WHATSAPP_WEBHOOK_VERIFY_TOKEN: Custom secret string for Meta Webhook verification challenge
WHATSAPP_WEBHOOK_VERIFY_TOKEN="collectiq_wa_webhook_verify_token_2025"

# WHATSAPP_APP_SECRET: App Secret from Meta App Dashboard > App settings > Basic (used to verify X-Hub-Signature-256)
WHATSAPP_APP_SECRET=""

# MSG91_AUTH_KEY: Authentication key from MSG91 control panel
MSG91_AUTH_KEY=""

# MSG91_SENDER_ID: 6-character registered DLT Sender ID / Header (e.g. COLTIQ)
MSG91_SENDER_ID="COLTIQ"

# MSG91_DLT_ENTITY_ID: 19-digit TRAI DLT Principal Entity ID
MSG91_DLT_ENTITY_ID=""

# FCM_SERVER_KEY: Firebase Cloud Messaging server key or service account for push notifications
FCM_SERVER_KEY=""

# ==============================================================================
# FIREBASE PRODUCTION CONFIGURATION (REQUIRED FOR VERCEL DEPLOYMENT)
# ==============================================================================
# In Vercel Project Settings > Environment Variables, add these keys matching your
# Firebase project from Firebase Console > Project Settings > General > Your apps:
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
# Optional: Set only if using a non-default named Firestore database instance
VITE_FIREBASE_DATABASE_ID=""
