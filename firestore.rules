rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitives & Helper Functions
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isBusinessMember(bizId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/businesses/$(bizId)) &&
         get(/databases/$(database)/documents/businesses/$(bizId)).data.ownerUid == request.auth.uid) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == bizId)
      );
    }

    function isBusinessAdmin(bizId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/businesses/$(bizId)) &&
         get(/databases/$(database)/documents/businesses/$(bizId)).data.ownerUid == request.auth.uid) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId == bizId &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin')
      );
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'businessId', 'role']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.businessId is string && data.businessId.size() <= 128 &&
             data.role in ['Admin', 'Manager', 'Collector', 'Viewer'];
    }

    // Validation Blueprint: Conversation
    function isValidConversation(data) {
      return data.keys().hasAll(['id', 'userId', 'businessId', 'title']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.businessId is string && data.businessId.size() <= 128 &&
             data.title is string && data.title.size() <= 200;
    }

    // Validation Blueprint: ChatMessage
    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'conversationId', 'userId', 'role', 'text']) &&
             data.id is string && data.id.size() <= 128 &&
             data.conversationId is string && data.conversationId.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.role in ['ai', 'user'] &&
             data.text is string && data.text.size() <= 5000;
    }

    // Validation Blueprint: Business
    function isValidBusiness(data) {
      return data.keys().hasAll(['businessId', 'businessName', 'ownerEmail', 'ownerUid']) &&
             data.businessId is string && data.businessId.size() <= 128 &&
             data.businessName is string && data.businessName.size() <= 128 &&
             data.ownerEmail is string && data.ownerEmail.size() <= 128 &&
             data.ownerUid is string && data.ownerUid.size() <= 128;
    }

    // Validation Blueprint: Invoice
    function isValidInvoice(data) {
      return data.keys().hasAll(['id', 'businessId', 'invoiceNumber', 'customerId', 'amount', 'status']) &&
             data.id is string && data.id.size() <= 128 &&
             data.businessId is string && data.businessId.size() <= 128 &&
             data.invoiceNumber is string && data.invoiceNumber.size() <= 64 &&
             data.customerId is string && data.customerId.size() <= 128 &&
             data.amount is number && data.amount >= 0 &&
             data.status in ['pending', 'overdue', 'paid', 'cancelled'];
    }

    // Validation Blueprint: Customer
    function isValidCustomer(data) {
      return data.keys().hasAll(['id', 'businessId', 'name', 'company', 'email']) &&
             data.id is string && data.id.size() <= 128 &&
             data.businessId is string && data.businessId.size() <= 128 &&
             data.name is string && data.name.size() <= 128 &&
             data.company is string && data.company.size() <= 128 &&
             data.email is string && data.email.size() <= 128;
    }

    // Validation Blueprint: FollowUp
    function isValidFollowUp(data) {
      return data.keys().hasAll(['id', 'businessId', 'customerId', 'customerName', 'amountDue', 'dueDate']) &&
             data.id is string && data.id.size() <= 128 &&
             data.businessId is string && data.businessId.size() <= 128 &&
             data.customerId is string && data.customerId.size() <= 128 &&
             data.customerName is string && data.customerName.size() <= 128 &&
             data.amountDue is number && data.amountDue >= 0 &&
             data.dueDate is string && data.dueDate.size() <= 32;
    }

    // Validation Blueprint: PromiseToPay
    function isValidPromise(data) {
      return data.keys().hasAll(['id', 'businessId', 'customerId', 'promisedAmount', 'promisedDate']) &&
             data.id is string && data.id.size() <= 128 &&
             data.businessId is string && data.businessId.size() <= 128 &&
             data.customerId is string && data.customerId.size() <= 128 &&
             data.promisedAmount is number && data.promisedAmount >= 0 &&
             data.promisedDate is string && data.promisedDate.size() <= 32;
    }

    // Validation Blueprint: Payment
    function isValidPayment(data) {
      return data.keys().hasAll(['id', 'businessId', 'invoiceId', 'amount', 'paymentDate']) &&
             data.id is string && data.id.size() <= 128 &&
             data.businessId is string && data.businessId.size() <= 128 &&
             data.invoiceId is string && data.invoiceId.size() <= 128 &&
             data.amount is number && data.amount >= 0 &&
             data.paymentDate is string && data.paymentDate.size() <= 32;
    }

    // Validation Blueprint: Task
    function isValidTask(data) {
      return data.keys().hasAll(['id', 'businessId', 'title']) &&
             data.id is string && data.id.size() <= 128 &&
             data.businessId is string && data.businessId.size() <= 128 &&
             data.title is string && data.title.size() <= 200;
    }

    // Validation Blueprint: ActivityLog
    function isValidActivityLog(data) {
      return data.keys().hasAll(['id', 'businessId', 'type', 'title']) &&
             data.id is string && data.id.size() <= 128 &&
             data.businessId is string && data.businessId.size() <= 128 &&
             data.type is string && data.type.size() <= 64 &&
             data.title is string && data.title.size() <= 200;
    }

    // Health probe / test connection document
    match /test/{testId} {
      allow get: if true;
    }

    // User Profile matching
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'photoURL']);
      allow delete: if isOwner(userId);

      // Private AI chat conversations for the user
      match /conversations/{conversationId} {
        allow list: if isOwner(userId);
        allow get: if isValidId(conversationId) && isOwner(userId);
        allow create: if isValidId(conversationId) && isOwner(userId) &&
                         incoming().userId == request.auth.uid &&
                         isValidConversation(incoming());
        allow update: if isValidId(conversationId) && isOwner(userId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().userId == existing().userId &&
                         isValidConversation(incoming());
        allow delete: if isValidId(conversationId) && isOwner(userId);

        match /messages/{messageId} {
          allow list: if isOwner(userId);
          allow get: if isValidId(messageId) && isOwner(userId);
          allow create: if isValidId(messageId) && isOwner(userId) &&
                           incoming().userId == request.auth.uid &&
                           incoming().conversationId == conversationId &&
                           isValidChatMessage(incoming());
          allow update: if isValidId(messageId) && isOwner(userId) &&
                           incoming().userId == request.auth.uid &&
                           isValidChatMessage(incoming());
          allow delete: if isValidId(messageId) && isOwner(userId);
        }
      }
    }

    // Multi-tenant Business matching
    match /businesses/{businessId} {
      allow get: if isSignedIn() && (existing().ownerUid == request.auth.uid || isBusinessMember(businessId));
      allow create: if isSignedIn() && isValidId(businessId) &&
                       incoming().ownerUid == request.auth.uid &&
                       isValidBusiness(incoming());
      allow update: if isBusinessAdmin(businessId) &&
                       isValidBusiness(incoming()) &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['businessName', 'phone', 'businessAddress', 'currency', 'currencySymbol', 'timezone', 'gstin']);
      allow delete: if isSignedIn() && (existing().ownerUid == request.auth.uid || isBusinessAdmin(businessId));

      // Subcollections scoped to Business
      match /invoices/{invoiceId} {
        allow list: if isBusinessMember(businessId);
        allow get: if isValidId(invoiceId) && isBusinessMember(businessId);
        allow create: if isValidId(invoiceId) && isBusinessMember(businessId) &&
                         incoming().businessId == businessId &&
                         isValidInvoice(incoming());
        allow update: if isValidId(invoiceId) && isBusinessMember(businessId) &&
                         incoming().businessId == existing().businessId &&
                         isValidInvoice(incoming());
        allow delete: if isValidId(invoiceId) && isBusinessAdmin(businessId);
      }

      match /customers/{customerId} {
        allow list: if isBusinessMember(businessId);
        allow get: if isValidId(customerId) && isBusinessMember(businessId);
        allow create: if isValidId(customerId) && isBusinessMember(businessId) &&
                         incoming().businessId == businessId &&
                         isValidCustomer(incoming());
        allow update: if isValidId(customerId) && isBusinessMember(businessId) &&
                         incoming().businessId == existing().businessId &&
                         isValidCustomer(incoming());
        allow delete: if isValidId(customerId) && isBusinessAdmin(businessId);
      }

      match /followUps/{followUpId} {
        allow list: if isBusinessMember(businessId);
        allow get, delete: if isValidId(followUpId) && isBusinessMember(businessId);
        allow create: if isValidId(followUpId) && isBusinessMember(businessId) &&
                         incoming().businessId == businessId &&
                         isValidFollowUp(incoming());
        allow update: if isValidId(followUpId) && isBusinessMember(businessId) &&
                         incoming().businessId == existing().businessId &&
                         isValidFollowUp(incoming());
      }

      match /promisesToPay/{promiseId} {
        allow list: if isBusinessMember(businessId);
        allow get, delete: if isValidId(promiseId) && isBusinessMember(businessId);
        allow create: if isValidId(promiseId) && isBusinessMember(businessId) &&
                         incoming().businessId == businessId &&
                         isValidPromise(incoming());
        allow update: if isValidId(promiseId) && isBusinessMember(businessId) &&
                         incoming().businessId == existing().businessId &&
                         isValidPromise(incoming());
      }

      match /payments/{paymentId} {
        allow list: if isBusinessMember(businessId);
        allow get: if isValidId(paymentId) && isBusinessMember(businessId);
        allow create: if isValidId(paymentId) && isBusinessMember(businessId) &&
                         incoming().businessId == businessId &&
                         isValidPayment(incoming());
        allow update: if isValidId(paymentId) && isBusinessMember(businessId) &&
                         incoming().businessId == existing().businessId &&
                         isValidPayment(incoming());
        allow delete: if isValidId(paymentId) && isBusinessAdmin(businessId);
      }

      match /paymentLinks/{linkId} {
        allow list, get: if isBusinessMember(businessId);
        allow create, update, delete: if isBusinessMember(businessId);
      }

      match /tasks/{taskId} {
        allow list: if isBusinessMember(businessId);
        allow get, delete: if isValidId(taskId) && isBusinessMember(businessId);
        allow create: if isValidId(taskId) && isBusinessMember(businessId) &&
                         incoming().businessId == businessId &&
                         isValidTask(incoming());
        allow update: if isValidId(taskId) && isBusinessMember(businessId) &&
                         incoming().businessId == existing().businessId &&
                         isValidTask(incoming());
      }

      match /activityLogs/{logId} {
        allow list: if isBusinessMember(businessId);
        allow get: if isValidId(logId) && isBusinessMember(businessId);
        allow create: if isValidId(logId) && isBusinessMember(businessId) &&
                         incoming().businessId == businessId &&
                         isValidActivityLog(incoming());
        allow update: if false;
        allow delete: if isBusinessAdmin(businessId);
      }

      match /activities/{logId} {
        allow list: if isBusinessMember(businessId);
        allow get: if isValidId(logId) && isBusinessMember(businessId);
        allow create: if isValidId(logId) && isBusinessMember(businessId);
        allow update: if false;
        allow delete: if isBusinessAdmin(businessId);
      }

      match /team/{memberId} {
        allow list, get: if isBusinessMember(businessId);
        allow create, update: if isBusinessAdmin(businessId);
        allow delete: if isBusinessAdmin(businessId) || isOwner(memberId);
      }
    }
  }
}
