{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account and role mapping to a business workspace",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 128 },
        "businessId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["Admin", "Manager", "Collector", "Viewer"] },
        "phone": { "type": "string", "maxLength": 32 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email", "businessId", "role"]
    },
    "Business": {
      "title": "Business",
      "description": "Multi-tenant company profile with billing configurations",
      "type": "object",
      "properties": {
        "businessId": { "type": "string", "maxLength": 128 },
        "businessName": { "type": "string", "maxLength": 128 },
        "ownerName": { "type": "string", "maxLength": 128 },
        "ownerEmail": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 32 },
        "businessAddress": { "type": "string", "maxLength": 256 },
        "currency": { "type": "string", "maxLength": 16 },
        "currencySymbol": { "type": "string", "maxLength": 8 },
        "timezone": { "type": "string", "maxLength": 64 },
        "gstin": { "type": "string", "maxLength": 32 },
        "createdDate": { "type": "string", "maxLength": 64 },
        "ownerUid": { "type": "string", "maxLength": 128 }
      },
      "required": ["businessId", "businessName", "ownerEmail", "ownerUid"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "B2B Accounts receivable invoice record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "businessId": { "type": "string", "maxLength": 128 },
        "invoiceNumber": { "type": "string", "maxLength": 64 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 128 },
        "customerEmail": { "type": "string", "maxLength": 128 },
        "customerCompany": { "type": "string", "maxLength": 128 },
        "issueDate": { "type": "string", "maxLength": 32 },
        "dueDate": { "type": "string", "maxLength": 32 },
        "amount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "balance": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "overdue", "paid", "cancelled"] },
        "overdueDays": { "type": "number" },
        "notes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "businessId", "invoiceNumber", "customerId", "amount", "status"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Debtor/client record for invoice collections",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "businessId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "company": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "phone": { "type": "string", "maxLength": 32 },
        "address": { "type": "string", "maxLength": 256 },
        "gstin": { "type": "string", "maxLength": 32 },
        "totalInvoiced": { "type": "number" },
        "totalPaid": { "type": "number" },
        "outstandingBalance": { "type": "number" },
        "overdueDays": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "overdue", "risk", "settled"] },
        "riskScore": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "businessId", "name", "company", "email"]
    },
    "FollowUp": {
      "title": "FollowUp",
      "description": "Payment collection follow-up schedule and reminder item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "businessId": { "type": "string", "maxLength": 128 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 128 },
        "invoiceNumber": { "type": "string", "maxLength": 64 },
        "amountDue": { "type": "number" },
        "dueDate": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["pending", "sent", "completed", "rescheduled", "overdue"] },
        "scheduledDate": { "type": "string", "maxLength": 32 },
        "channel": { "type": "string", "enum": ["WhatsApp", "Email", "SMS", "Call"] },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "businessId", "customerId", "customerName", "amountDue", "dueDate"]
    },
    "PromiseToPay": {
      "title": "PromiseToPay",
      "description": "Formal debtor repayment commitment",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "businessId": { "type": "string", "maxLength": 128 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 128 },
        "invoiceId": { "type": "string", "maxLength": 128 },
        "invoiceNumber": { "type": "string", "maxLength": 64 },
        "promisedAmount": { "type": "number" },
        "promisedDate": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["pending", "fulfilled", "broken", "overdue"] },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "businessId", "customerId", "promisedAmount", "promisedDate"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Reconciled accounts receivable payment entry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "businessId": { "type": "string", "maxLength": 128 },
        "invoiceId": { "type": "string", "maxLength": 128 },
        "invoiceNumber": { "type": "string", "maxLength": 64 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "paymentDate": { "type": "string", "maxLength": 32 },
        "paymentMethod": { "type": "string", "enum": ["Bank Transfer", "UPI", "Cheque", "Credit Card", "Cash"] },
        "referenceNumber": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["reconciled", "processing", "refunded"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "businessId", "invoiceId", "amount", "paymentDate"]
    },
    "Task": {
      "title": "Task",
      "description": "Collection operator daily tasks and calls",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "businessId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "customerName": { "type": "string", "maxLength": 128 },
        "time": { "type": "string", "maxLength": 64 },
        "dueToday": { "type": "boolean" },
        "completed": { "type": "boolean" },
        "priority": { "type": "string", "enum": ["high", "medium", "low"] },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "businessId", "title"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit trail log of reminders sent and actions executed",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "businessId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 500 },
        "customerName": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "channel": { "type": "string", "maxLength": 64 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "businessId", "type", "title"]
    },
    "TestConnection": {
      "title": "TestConnection",
      "description": "Heartbeat diagnostic document for connection verification",
      "type": "object",
      "properties": {
        "status": { "type": "string", "maxLength": 32 },
        "timestamp": { "type": "string", "maxLength": 64 }
      },
      "required": ["status"]
    }
  },
  "firestore": {
    "/test/{testId}": {
      "schema": "TestConnection",
      "description": "Connection test probe document"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document containing tenant business assignment"
    },
    "/businesses/{businessId}": {
      "schema": "Business",
      "description": "Business organization profile and owner mapping"
    },
    "/businesses/{businessId}/invoices/{invoiceId}": {
      "schema": "Invoice",
      "description": "Invoices collection scoped to the owning business tenant"
    },
    "/businesses/{businessId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "Customers directory scoped to the owning business tenant"
    },
    "/businesses/{businessId}/followUps/{followUpId}": {
      "schema": "FollowUp",
      "description": "Collection reminders and follow-ups scoped to the business tenant"
    },
    "/businesses/{businessId}/promisesToPay/{promiseId}": {
      "schema": "PromiseToPay",
      "description": "Promises to pay scoped to the business tenant"
    },
    "/businesses/{businessId}/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Reconciliation payments scoped to the business tenant"
    },
    "/businesses/{businessId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Collector tasks scoped to the business tenant"
    },
    "/businesses/{businessId}/activityLogs/{logId}": {
      "schema": "ActivityLog",
      "description": "Activity audit log scoped to the business tenant"
    }
  }
}
